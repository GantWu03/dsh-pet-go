{
  "name": "大肥鱼",
  "source": {
    "project": "dsh-pet",
    "url": "https://github.com/PC2005-cloud/dsh-pet",
    "license": "MIT"
  },
  "stage": { "width": 640, "height": 360 },
  "viewport": { "x": 168, "y": 2, "width": 308, "height": 334 },
  "preferred": { "width": 90, "height": 98 },
  "states": {
    "idle": { "clip": "idle.webm", "loop": true },
    "listening": { "clip": "listening.webm", "loop": false, "then": "idle" },
    "thinking": { "clip": "thinking.webm", "loop": true },
    "answering": { "clip": "answering.webm", "loop": true },
    "done": { "clip": "done.webm", "loop": false, "then": "idle" },
    "drag": { "clip": "drag.webm", "loop": true },
    "error": { "clip": "thinking.webm", "loop": true }
  }
}
