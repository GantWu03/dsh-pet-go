{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.js",
    "packages/*/*.js",
    "packages/*/*.cjs",
    "tests/**/*.ts",
    "tests/**/*.mjs",
    "scripts/**/*.mjs",
    "types/**/*.d.ts"
  ],
  "exclude": ["tests/fixtures/**", "node_modules", "packages/*/lib", "packages/*/dist"]
}
